# SPDX-License-Identifier: GPL-2.0-only
# OnePlus Pad 3 (erhai) board options. Merge on top of arm64 defconfig,
# erhai-firstboot.config, sm8750-peripherals.config and
# sm8750-netfilter.config.
#
# PPS fast charging through the SC8547A charge pumps. The pen charger
# stays off.
CONFIG_CHARGER_SC8547A=m
CONFIG_CHARGER_ERHAI_PPS=m
CONFIG_CHARGER_CPS8601=m
# Large console font for the 3392x2400 panel.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
# Pogo keyboard and touchpad, also usable from the initramfs shell.
CONFIG_KEYBOARD_ONEPLUS_POGO=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
# The root filesystem lives on UFS; the initramfs mounts it directly.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
# No raw UFS commands from userspace.
# CONFIG_SCSI_UFS_BSG is not set
# Encrypted root: the UFS inline crypto engine encrypts userdata through
# dm-inlinecrypt, with dm-crypt on the CPU AES instructions as the fallback.
# cryptsetup needs the user space cipher and hash interfaces for the LUKS
# key slots.
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INLINECRYPT=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
# CONFIG_SCSI_UFS_CDNS_PLATFORM is not set
# Release name of the installed kernel and its modules.
CONFIG_LOCALVERSION="-erhai"
# Buffers for libcamera software ISP output.
CONFIG_UDMABUF=y
# Run programs of other architectures through a registered interpreter.
CONFIG_BINFMT_MISC=y
# Camera clocks, CSI PHYs and the camera I2C controller probe during startup,
# before the storage password, so they never wait on modules loaded later.
CONFIG_SM_CAMCC_8750=y
CONFIG_PHY_QCOM_MIPI_CSI2=y
CONFIG_I2C_QCOM_CCI=y

# Power off anyway if the orderly shutdown of a critical thermal trip has
# not finished within 60 s.
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=60000

# Multi-generational LRU for page reclaim, on from boot.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
